@startuml
actor Client
participant "UserController" as Controller
participant "UserService" as Service
participant "UserDAO (GORM)" as DAO
database "PostgreSQL" as DB

Client -> Controller: PUT /api/v1/users/{id}\nAuthorization: Bearer <token>\n{name?, surname?, email?, ...}
activate Controller

Controller -> Controller: Extract userID from URL param
Controller -> Controller: BindJSON → UserUpdateRequest

alt Invalid body
    Controller --> Client: HTTP 400\n{code: "Bad request"}
end

Controller -> Service: Update(ctx, id, request)
activate Service

Service -> DAO: FindByID(ctx, id)
activate DAO
DAO -> DB: SELECT * FROM users WHERE id = ?
DB --> DAO: user or nil
deactivate DAO

alt User no encontrado
    Service --> Controller: error
    Controller --> Client: HTTP 500\n{code: "Internal Server Error"}
end

Service -> Service: Apply updates (non-nil fields only)
note right: Only provided fields\nare updated

Service -> Service: Validate email uniqueness
Service -> DAO: Update(ctx, userDB)
activate DAO
DAO -> DB: UPDATE users SET ... WHERE id = ?
DB --> DAO: updated rows
deactivate DAO

alt DB error
    Service --> Controller: error
    Controller --> Client: HTTP 500\n{code: "Internal Server Error"}
end

Service --> Controller: *UserUpdateResponse
deactivate Service

Controller --> Client: HTTP 200\n{user_id, name, email, ...}
deactivate Controller
@enduml
