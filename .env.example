# Database — dos proyectos de Supabase (testing/production), ver docs/ENVIRONMENTS.md.
# Sin --stage=production al arrancar, SIEMPRE se usa la de testing (default seguro).
SUPABASE_TESTING_DATABASE_URL=postgresql://user:password@host:port/dbname
SUPABASE_PRODUCTION_DATABASE_URL=postgresql://user:password@host:port/dbname

# O individualmente (fallback legacy, sin distinción de stage):
# db_host=localhost
# db_port=5432
# db_user=postgres
# db_password=secret
# db_name=paceron_db

# Environment
ENVIRONMENT=local

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:5173,http://localhost:3000,https://paceron-frontend.vercel.app,https://paceron-frontend-git-develop-paceron.vercel.app

# JWT
JWT_SECRET=your-secret-key-at-least-32-characters-long

# Mailer (envío de correos vía Resend, https://resend.com — dominio verificado)
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_ADDRESS=Paceron <no-reply@paceron.com>

# Mercado Pago — credenciales de HOMOLOGACIÓN (sandbox), NO producción
# Ver docs/PAYMENT_TESTING.md para el paso a paso completo
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxx-xxxx-xxxx
MERCADOPAGO_PUBLIC_KEY=TEST-xxxx-xxxx-xxxx
MERCADOPAGO_WEBHOOK_SECRET=tu-webhook-secret-aqui
MERCADOPAGO_WEBHOOK_URL=https://tu-backend.ngrok.io/api/v1/payments/webhook
MERCADOPAGO_CURRENCY_ID=ARS

# Mercado Pago — OAuth mp-connect (split payments: el entrenador conecta su cuenta
# para cobrar las mensualidades de su equipo y Paceron retiene comisión).
# Se obtienen en https://www.mercadopago.com.ar/developers → tu app.
# MP_OAUTH_CLIENT_ID: client_id de la app (número).
# MP_OAUTH_CLIENT_SECRET: client_secret de la app.
# MP_OAUTH_REDIRECT_URI: URL pública (ngrok/Render) donde MP redirige la vuelta
#   del OAuth. Debe terminar en la ruta del callback del backend:
#   .../api/v1/mercadopago/connect/callback. Tiene que coincidir EXACTA con la
#   registrada en la app de MP y con la que usa GET /api/v1/mercadopago/connect.
# MP_OAUTH_TEST_TOKEN: por defecto es TRUE (manda test_token=true en el
#   exchange/refresh del code por token). Poner "false" solo si se quieren
#   tokens reales de producción.
MP_OAUTH_CLIENT_ID=
MP_OAUTH_CLIENT_SECRET=
MP_OAUTH_REDIRECT_URI=
MP_OAUTH_TEST_TOKEN=true

# Clave para CIFRAR los tokens de seller_connections (AES-GCM). Debe tener
# exactamente 16/24/32 bytes según el algoritmo (se recomienda 32). NUNCA se
# loguean ni exponen los tokens en claro; ver cmd/api/infrastructure/crypto.
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# Storage — S3-compatible de Supabase, mismo split testing/producción que la DB
# (sin --stage=production SIEMPRE se usa la de testing). Bucket público de lectura.
# La URL pública se deriva del ENDPOINT + BUCKET (no hace falta una env var aparte).
SUPABASE_TESTING_S3_ENDPOINT=https://xxxx.storage.supabase.co/storage/v1/s3
SUPABASE_TESTING_S3_REGION=sa-east-1
SUPABASE_TESTING_S3_ACCESS_ID=xxxx
SUPABASE_TESTING_S3_SECRET_KEY=xxxx
SUPABASE_TESTING_S3_BUCKET=paceron-media

SUPABASE_PRODUCTION_S3_ENDPOINT=https://yyyy.storage.supabase.co/storage/v1/s3
SUPABASE_PRODUCTION_S3_REGION=sa-east-1
SUPABASE_PRODUCTION_S3_ACCESS_ID=yyyy
SUPABASE_PRODUCTION_S3_SECRET_KEY=yyyy
SUPABASE_PRODUCTION_S3_BUCKET=paceron-media
