# Database — usar DATABASE_URL (prioritario) o variables individuales
DATABASE_URL=postgresql://user:password@host:port/dbname

# O individualmente:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=secret
# DB_NAME=paceron_db

# Environment
ENVIRONMENT=local

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:5173,http://localhost:3000,https://paceron-frontend.vercel.app,https://paceron-frontend-git-develop-paceron.vercel.app

# JWT
JWT_SECRET=your-secret-key-at-least-32-characters-long

# SMTP (envío de correos vía Gmail)
GMAIL_USER=x@gmail.com
GMAIL_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
