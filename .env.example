# Database — usar DATABASE_URL (prioritario) o variables individuales
DATABASE_URL=postgresql://user:password@host:port/dbname

# O individualmente:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=secret
# DB_NAME=paceron_db

# Environment
ENVIRONMENT=local

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:5173,http://localhost:3000

# JWT
JWT_SECRET=your-secret-key-at-least-32-characters-long
